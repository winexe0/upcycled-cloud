        if (headingEnd == std::string::npos) break;

        int level = 1;
        while (headingStart != std::string::npos && level <= std::min(6, headingStart - html.rfind("#", headingStart - 1))) {
            headingStart = html.find("#", headingStart + 1);
            level++;
        }

        std::string headingText = html.substr(headingStart + 1, headingEnd - headingStart - 1);
        html.replace(headingStart, headingEnd - headingStart, "<h" + std::to_string(level) + ">" + headingText + "</h" + std::to_string(level) + ">");
        headingStart = html.find("#", headingEnd);
    }

    // Convert lists (Markdown: - item, * item, or 1. item)
    size_t listStart = html.find("-");
    while (listStart != std::string::npos) {
        size_t listEnd = html.find("\n", listStart);
