        std::string listItem = html.substr(listStart + 1, listEnd - listStart - 1);
        html.replace(listStart, listEnd, "<li>" + listItem + "</li>");
        listStart = html.find("-", listEnd);
    }

    listStart = html.find("*");
    while (listStart != std::string::npos) {
        size_t listEnd = html.find("\n", listStart);
        if (listEnd == std::string::npos) break;

        std::string listItem = html.substr(listStart + 1, listEnd - listStart - 1);
        html.replace(listStart, listEnd, "<li>" + listItem + "</li>");
        listStart = html.find("*", listEnd);
    }

    listStart = html.find("1.");
