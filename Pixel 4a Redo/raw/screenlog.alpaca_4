#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Convert bold (double asterisks or underscores)
    html += markdown;
    html.replace(html.find("**"), 2, "<strong>");
    html.replace(html.find("__"), 2, "<strong>");
    html.replace(html.find("**"), 2, "</strong>");
    html.replace(html.find("__"), 2, "</strong>");

    // Convert italic (single asterisks or underscores)
    html.replace(html.find("*"), 1, "<em>");
    html.replace(html.find("_"), 1, "<em>");
    html.replace(html.find("*"), 1, "</em>");
    html.replace(html.find("_"), 1, "</em>");

    // Convert links (Markdown: [text](url))
    size_t linkStart = html.find("[");
    while (linkStart != std::string::npos) {
        size_t linkEnd = html.find("]", linkStart);
        if (linkEnd == std::string::npos) break;

        size_t urlStart = html.find("(", linkEnd);
        if (urlStart == std::string::npos) break;

        size_t urlEnd = html.find(")", urlStart);
        if (urlEnd == std::string::npos) break;

        std::string linkText = html.substr(linkStart + 1, linkEnd - linkStart - 1);
        std::string url = html.substr(urlStart + 1, urlEnd - urlStart - 1);

        html.replace(linkStart, urlEnd - linkStart + 1, "<a href=\"" + url + "\">" + linkText + "</a>");
        linkStart = html.find("[", urlEnd);
    }

