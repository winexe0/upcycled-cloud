\[
A(x) = \frac{f(x + h) - f(x)}{h}
\]

where `h` is a small step size (e.g., `h = 0.001`). If you have a specific function in mind, replace `f(x)` with it.

### Python Script:
```python
def average_rate_of_change(f, a, b):
    """
    Compute the average rate of change of function f between points a and b.
    This is a finite difference approximation of the derivative at x = (a + b)/2.
    """
    h = (b - a) / 1000  # Small step size for numerical differentiation
    x = (a + b) / 2      # Midpoint (can be adjusted)
    return (f(x + h) - f(x)) / h

def main():
    print("Enter a function f(x) in the form 'lambda x: ...' (e.g., 'lambda x: x**2').")
    print("Example: 'lambda x: x**2' for f(x) = x^2.")
    print("Example: 'lambda x: x**3 + 2*x' for f(x) = x^3 + 2x.")

    try:
        # Get user input for the function
        user_function_str = input("Enter the function f(x): ")
        f = eval(user_function_str)  # Evaluate the lambda function (use with caution!)

        # Get user input for the derivative point (x)
        x = float(input("Enter the point x where you want to compute the derivative: "))

        # Compute the derivative using average rate of change
        derivative = average_rate_of_change(f, x - 0.001, x + 0.001)
        print(f"\nThe derivative of f(x) at x = {x} (using average rate of change) is: {derivative:.6f}")

    except Exception as e:
        print(f"Error: {e}. Please ensure the function is correctly formatted.")

if __name__ == "__main__":
    main()
```

