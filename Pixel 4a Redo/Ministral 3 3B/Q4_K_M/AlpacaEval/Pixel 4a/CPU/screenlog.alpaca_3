```cpp
#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Replace # for h1, ## for h2, etc.
    size_t pos = 0;
    while ((pos = markdown.find('#', pos)) != std::string::npos) {
        size_t level = 0;
        while (pos > 0 && markdown[pos - 1] == '#') {
            level++;
            pos--;
        }
        pos++; // Skip the '#'
        std::string heading = markdown.substr(pos, markdown.find('\n', pos) - pos);
        html += "<h" + std::to_string(level) + ">" + heading + "</h" + std::to_string(level) + ">\n";
        pos = markdown.find('\n', pos);
    }

    // Replace *bold* or **bold** -> <b>bold</b>
    pos = 0;
    while ((pos = markdown.find('*', pos)) != std::string::npos) {
        if (pos + 1 < markdown.size() && markdown[pos + 1] == '*') {
            size_t end = markdown.find('*', pos + 2);
            if (end != std::string::npos) {
                std::string boldText = markdown.substr(pos + 2, end - pos - 2);
                html += "<b>" + boldText + "</b>";
                pos = end;
            }
        } else {
            pos++;
        }
    }

    // Replace *italic* -> <i>italic</i>
    pos = 0;
    while ((pos = markdown.find('*', pos)) != std::string::npos) {
        if (pos + 1 < markdown.size() && markdown[pos + 1] != '*') {
            size_t end = markdown.find('*', pos + 1);
            if (end != std::string::npos) {
                std::string italicText = markdown.substr(pos + 1, end - pos - 1);
                html += "<i>" + italicText + "</i>";
                pos = end;
            }
        } else {
            pos++;
        }
    }

    // Replace [text](url) -> <a href="url">text</a>
    pos = 0;
    while ((pos = markdown.find('[' , pos)) != std::string::npos) {
        size_t start = pos + 1;
        size_t end = markdown.find(']', start);
        if (end == std::string::npos) break;

        size_t urlStart = markdown.find('(', end);
        if (urlStart == std::string::npos) break;
        size_t urlEnd = markdown.find(')', urlStart);
        if (urlEnd == std::string::npos) break;

        std::string text = markdown.substr(start, end - start);
        std::string url = markdown.substr(urlStart + 1, urlEnd - urlStart - 1);
        html += "<a href=\"" + url + "\">" + text + "</a>";
        pos = urlEnd;
    }

    // Replace ![alt](url) -> <img src="url" alt="alt">
    pos = 0;
    while ((pos = markdown.find('!', pos)) != std::string::npos) {
        size_t altStart = pos + 1;
        size_t altEnd = markdown.find('[', altStart);
        if (altEnd == std::string::npos) break;

        size_t urlStart = markdown.find('(', altEnd);
        if (urlStart == std::string::npos) break;
        size_t urlEnd = markdown.find(')', urlStart);
        if (urlEnd == std::string::npos) break;

        std::string alt = markdown.substr(altStart, altEnd - altStart);
        std::string url = markdown.substr(urlStart + 1, urlEnd - urlStart - 1);
        html += "<img src=\"" + url + "\" alt=\"" + alt + "\">";
        pos = urlEnd;
    }

    // Replace - for bullet points
    pos = 0;
    while ((pos = markdown.find('-', pos)) != std::string::npos) {
        if (pos > 0 && markdown[pos - 1] == ' ') {
            html += "<li>";
            pos--;
        } else {
            pos++;
        }
    }



