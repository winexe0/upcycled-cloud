#include <iostream>
#include <string>
#include <stdexcept>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Define a map to map markdown syntax to html tags
    static const std::map<std::string, std::string> markdownToHtmlMap = {
        {"*italic*", "<i>"},
        {"**bold**, *italic*", "<b><i>"},
        {"~~strikethrough~~", "<s>"},
        {"[link](http://example.com)", "<a href=\"http://example.com\">"},
        {"[image](http://example.com/image.jpg)", "<img src=\"http://example.com/image.jpg\">"},
        {"# heading", "<h1>"},
        {"## subheading", "<h2>"},
        {"### subsubheading", "<h3>"},
        {"#### subsubsubheading", "<h4>"},
        {"##### subsubsubsubheading", "<h5>"},
        {"###### subsubsubsubsubheading", "<h6>"}
    };

    std::string htmlText = markdownText;

    // Iterate over the markdown to html map and replace markdown syntax with html tags
    for (const auto& pair : markdownToHtmlMap) {
        size_t pos = 0;
        while ((pos = htmlText.find(pair.first, pos)) != std::string::npos) {
            htmlText.replace(pos, pair.first.length(), pair.second);
            pos += pair.second.length();
        }
    }

    return htmlText;
}

int main() {
    std::string markdownText = "*italic* **bold**, *italic* ~~strikethrough~~ [link](http://example.com) ![image](http://example.com/image.jpg) # heading";
    std::cout << markdownToHtml(markdownText) << std::endl;

    return 0;
}
```

This C++ function uses a map to map markdown syntax to html tags. It then iterates over the map and replaces markdown syntax with html tags in the input string. The function returns the resulting html formatted text.

Note that this implementation only supports a limited subset of markdown syntax. For a full implementation, you would need to support more syntax and handle edge cases.

