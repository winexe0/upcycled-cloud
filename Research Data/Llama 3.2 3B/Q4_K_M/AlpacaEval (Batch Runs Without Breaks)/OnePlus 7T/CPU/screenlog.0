|-\|/-\|/-\|/-\|/-\|/-\|/-\ ```cpp
#include <iostream>
#include <string>
#include <stdexcept>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Define a map to map markdown syntax to html tags
    static const std::map<std::string, std::string> markdownToHtmlMap = {
        {"*", "*"},
        {"_", "<i>"},
        {"[", "<a>"],
        {"]", "</a>"},
        {"(", "<"),
        {")", ">"},
        {"#", "<h1>"},
        {"##", "<h2>"},
        {"###", "<h3>"},
        {"####", "<h4>"},
        {"#####", "<h5>"},
        {"######", "<h6>"}
    };

    std::string htmlText = markdownText;

    // Replace markdown syntax with html tags
    for (const auto& pair : markdownToHtmlMap) {
        size_t pos = 0;
        while ((pos = htmlText.find(pair.first, pos)) != std::string::npos) {
            htmlText.replace(pos, pair.first.length(), pair.second);
            pos += pair.second.length();
        }
    }

    return htmlText;
}

int main() {
    std::string markdownText = "# Hello, World!";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;
    return 0;
}
```

This C++ function, `markdownToHtml`, takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text. It uses a map to map markdown syntax to html tags and replaces markdown syntax with html tags in the input string. The function is demonstrated in the `main` function, where it converts the markdown text "# Hello, World!" to html text.

