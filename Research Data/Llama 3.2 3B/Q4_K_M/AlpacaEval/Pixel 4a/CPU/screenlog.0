Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/ ```cpp
#include <iostream>
#include <string>
#include <stdexcept>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Define a map to map markdown syntax to html tags
    static const std::map<std::string, std::string> markdownToHtmlMap = {
        {"*", "*"},
        {"_", "<em>"},
        {"[", "<a>"],
        {"]", "</a>"},
        {"(", "<"),
        {")", ">"},
        {"#", "<h1>"},
        {"##", "<h2>"},
        {"###", "<h3>"},
        {"####", "<h4>"},
        {"#####", "<h5>"},
        {"######", "<h6>"}
    };

    std::string htmlText = markdownText;

    // Iterate over the markdownToHtmlMap and replace markdown syntax with html tags
    for (const auto& pair : markdownToHtmlMap) {
        size_t pos = 0;
        while ((pos = htmlText.find(pair.first, pos)) != std::string::npos) {
            htmlText.replace(pos, pair.first.length(), pair.second);
            pos += pair.second.length();
        }
    }

    // Replace markdown bold syntax with html bold tags
    size_t pos = 0;
    while ((pos = htmlText.find("**", pos)) != std::string::npos) {
        htmlText.replace(pos, 2, "<b>");
        pos += 3;
    }
    pos = 0;
    while ((pos = htmlText.find("**", pos)) != std::string::npos) {
        htmlText.replace(pos, 2, "</b>");
        pos += 3;
    }

    // Replace markdown italic syntax with html italic tags
    pos = 0;
    while ((pos = htmlText.find("_", pos)) != std::string::npos) {
        htmlText.replace(pos, 1, "<em>");
        pos += 4;
    }
    pos = 0;
    while ((pos = htmlText.find("_", pos)) != std::string::npos) {
        htmlText.replace(pos, 1, "</em>");
        pos += 4;
    }

    return htmlText;
}

int main() {
    std::string markdownText = "# Heading\n**Bold text**\n_Italic text_";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;
    return 0;
}
```

This C++ function, `markdownToHtml`, takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text. It uses a map to map markdown syntax to html tags and replaces markdown syntax with html tags. Additionally, it handles markdown bold and italic syntax by wrapping the text in `<b>` and `<em>` tags, respectively.

