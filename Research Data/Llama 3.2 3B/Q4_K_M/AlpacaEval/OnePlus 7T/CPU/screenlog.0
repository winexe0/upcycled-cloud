|-\|/-\|/-\|/-\|/-\|/-\|/ ```cpp
#include <iostream>
#include <string>
#include <stdexcept>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Define a map of markdown syntax to html syntax
    static const std::map<std::string, std::string> markdownToHtmlMap = {
        {"*italic*", "<i>"},
        {"**bold**, *italic*", "<b><i>"},
        {"~~strikethrough~~", "<s>"},
        {"[link](http://example.com)", "<a href=\"http://example.com\">"},
        {"[image](http://example.com/image.jpg)", "<img src=\"http://example.com/image.jpg\">"},
        {"# heading", "<h1>"},
        {"## subheading", "<h2>"},
        {"### subsubheading", "<h3>"},
        {"#### subsubsubheading", "<h4>"},
        {"##### subsubsubsubheading", "<h5>"},
        {"###### subsubsubsubsubheading", "<h6>"}
    };

    std::string htmlText = markdownText;

    // Iterate over the markdown to html map and replace markdown syntax with html syntax
    for (const auto& pair : markdownToHtmlMap) {
        size_t pos = 0;
        while ((pos = htmlText.find(pair.first, pos)) != std::string::npos) {
            htmlText.replace(pos, pair.first.length(), pair.second);
            pos += pair.second.length();
        }
    }

    return htmlText;
}

int main() {
    std::string markdownText = "*italic* **bold**, *italic* ~~strikethrough~~ [link](http://example.com) ![image](http://example.com/image.jpg)";
    std::cout << markdownToHtml(markdownText) << std::endl;

    return 0;
}
```

This C++ function uses a map to map markdown syntax to html syntax. It then iterates over the map and replaces markdown syntax with html syntax in the input string. The function returns the resulting html formatted text.

Note that this implementation only supports a limited subset of markdown syntax. You may need to add more syntax to the map to support all the features you need.

