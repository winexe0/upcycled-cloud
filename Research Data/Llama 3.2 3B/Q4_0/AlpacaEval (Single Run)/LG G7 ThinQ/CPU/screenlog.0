def average_rate_of_change(a, b, f):
    """
    Calculate the derivative using the Average Rate of Change Formula.

    Args:
        a (float): The starting point.
        b (float): The ending point.
        f (function): The function for which to calculate the derivative.

    Returns:
        float: The derivative of the function at point x.
    """
    return (f(b) - f(a)) / (b - a)


def main():
    # Get user input for 'a' and 'b'
    a = float(input("Enter the starting point (x=a): "))
    b = float(input("Enter the ending point (x=b): "))

    # Get the function from the user
    func_name = input("Enter the function (e.g., 'x**2', '2*x', 'x**3 + 1'): ")
    func = eval(func_name)

    # Calculate the derivative
    derivative = average_rate_of_change(a, b, func)

    # Print the result
    print(f"The derivative of f(x) = {func_name} at x = {a} is {derivative}")


if __name__ == "__main__":
    main()
```

