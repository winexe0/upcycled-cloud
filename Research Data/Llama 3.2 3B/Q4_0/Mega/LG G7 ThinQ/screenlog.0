#include <string>
#include <regex>

std::string markdownToHtml(const std::string& md) {
    std::string html = md;
    html = std::regex_replace(html, std::regex("\\*\\*(.*?)\\*\\*"), "<b>$1</b>");
    html = std::regex_replace(html, std::regex("\\*(.*?)\\"), "<i>$1</i>");
    html = std::regex_replace(html, std::regex("#(.*?)\\n"), "<h1>$1</h1>\n");
    return html;
}
```

