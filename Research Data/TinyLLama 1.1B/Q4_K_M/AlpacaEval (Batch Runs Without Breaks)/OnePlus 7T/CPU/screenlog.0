Instruction:
Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/ Here's an example implementation of the requested function:

```c++
#include <iostream>
#include <string>

using namespace std;

// Function to convert markdown formatted text to HTML
string markdownToHtml(const string& markdown) {
    // Split the markdown string into lines
    vector<string> lines;
    string line;
    for (const char& c : markdown) {
        if (c == '\n') {
            lines.push_back(line);
            line.clear();
        } else {
            line += c;
        }
    }
    if (!line.empty()) {
        lines.push_back(line);
    }

    // Convert each line to an HTML element
    string html;
    for (const string& line : lines) {
        html += "<p>" + line + "</p>";
    }

    return html;
}

int main() {
    string input = "Hello, world! This is some text with [markdown](https://example.com) and [inline](http://example.com) links. ";
    string output = markdownToHtml(input);
    cout << output << endl;

    return 0;
}
```

This function takes a reference to a std::string containing markdown formatted text and returns a std::string containing HTML formatted text. It first splits the input string into lines using the `string` constructor, and then iterates over each line, converting it to an HTML element using the `string` constructor. Finally, it concatenates all HTML elements into a single string using the `string` constructor.

