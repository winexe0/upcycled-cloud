```cpp
#include <string>
#include <iostream>

using namespace std;

string markdownToHtml(string input) {
    string output = "<|user|>";
    // Replace all instances of '|system|' with 'system'
    input = input.replace("|system|", "system");
    // Remove all non-alphanumeric characters
    input = input.replace("[^a-zA-Z0-9]", "");
    // Remove all leading and trailing whitespace
    input = input.trim();
    // Replace all instances of '>' with '>'
    input = input.replace(">", ">");
    // Replace all instances of '<|user|> with 'system'
    input = input.replace(">|system|", ">system");
    // Replace all instances of '<|assistant|> with 'system'
    input = input.replace(">|assistant|>", ">system");
    // Replace all instances of '>' with '>'
    input = input.replace(">|user|>", ">user|>");
    // Replace all instances of '>' with '>'
    input = input.replace(">|assistant|>|user|>|system|", ">user|>system|");
    // Replace all instances of '>' with '>'
    output = output.replace(">|user|>|assistant|>|system|", ">user|assistant|>system|");
    return output;
}

int main() {
    string input = "Hello, world! This is a test to see how the markdown to html function works. ";
    string output = markdownToHtml(input);
    cout << output << endl;
    return 0;
}
```

