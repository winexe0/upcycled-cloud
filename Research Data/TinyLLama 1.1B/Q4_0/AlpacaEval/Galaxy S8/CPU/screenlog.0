#include <string>
#include <iostream>

using namespace std;

string markdownToHtml(string input) {
    string output = input;
    string html = "<|system|>";

    // Replace all occurrences of `<|user|>` with the user's input
    string::replace(output.begin(), output.end(), "<<user|>", input);

    // Replace all occurrences of `>` with `>`
    string::replace(output.begin(), output.end(), ">|assistant|>", ">");

    // Remove any leading or trailing whitespace
    output.erase(0, output.find_last_not_of(" \t\n") + 1);
    output.erase(output.find_last_not_of(" \t\n") + 1, output.length());

    // Trim any leading or trailing spaces
    output.erase(0, output.find_first_not_of(" \t\n") + 1);
    output.erase(output.find_first_not_of(" \t\n") + 1, output.length());

    // Remove any leading or trailing newlines
    output.erase(0, output.find_first_not_of("\n") + 1);
    output.erase(output.find_first_not_of("\n") + 1, output.length());

    // Return the modified output
    return output;
}

int main() {
    string input = "Hello, world!";
    string output = markdownToHtml(input);
    cout << output << endl;
    return 0;
}
