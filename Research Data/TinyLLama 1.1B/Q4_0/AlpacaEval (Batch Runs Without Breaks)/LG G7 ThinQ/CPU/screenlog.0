#include <string>
#include <iostream>

std::string markdownToHtml(const std::string& markdown) {
    // Convert markdown to HTML
    std::string html;
    std::string line;
    for (const auto& char : markdown) {
        if (char == '\n') {
            html += "<br>";
        } else if (char == '>') {
            html += "<|assistant|>";
        } else if (char == '<') {
            html += "<|user|>";
        } else {
            html += char;
        }
    }
    return html;
}
```

This function takes a reference to a std::string containing markdown formatted text and returns a new std::string containing HTML formatted text. It uses a loop to convert each character in the markdown string to its corresponding HTML entity. The function then appends the HTML to the end of the resulting string.

