import math

def arc_derivative(x, a, b):
    """
    Calculates the derivative of a function using the Average Ratio of Change (ARC) formula.
    :param x: The value of the function at the end point (x_end)
    :param a: The starting point (x_start)
    :param b: The end point (x_end)
    :return: The derivative of the function at x_end
    """
    if x < a or x > b:
        raise ValueError("Input x must be between {} and {}".format(a, b))
    
    # Calculate the difference between the end points
    delta = b - a
    
    # Calculate the ratio of the difference to the range of the function
    ratio = delta / (b - a)
    
    # Calculate the derivative using the ARC formula
    derivative = ratio * (a - x)
    
    return derivative

# Example usage
x = float(input("Enter the starting point (x_start): "))
a = float(input("Enter the end point (x_end): "))
b = float(input("Enter the end point (x_end): "))

derivative = arc_derivative(x, a, b)
print("The derivative of the function at x_end is:", derivative)
```

