import math

def arc_derivative(x, a, b):
    """
    Calculates the derivative of a function using the Average Rate of Change (ARC) formula.
    :param x: The value of x at which the derivative is required.
    :param a: The lower bound of the interval over which the derivative is required.
    :param b: The upper bound of the interval over which the derivative is required.
    :return: The derivative of the function at x.
    """
    if x < a or x > b:
        raise ValueError("Input x is out of range.")
    
    # Calculate the difference between the lower and upper bounds
    delta = b - a
    
    # Calculate the ratio of the difference to the interval
    ratio = delta / (b - a)
    
    # Calculate the derivative using the Average Rate of Change formula
    derivative = ratio * (a - x)
    
    return derivative

# Prompt the user for the function and its parameters
print("Enter the function:")
print("Enter the lower bound (a):")
print("Enter the upper bound (b):")

# Read the user input
a = float(input("Enter the lower bound (a): "))
b = float(input("Enter the upper bound (b): "))

# Calculate the derivative using the Average Rate of Change formula
derivative = arc_derivative(float(input("Enter the value of x: ")), a, b)

# Output the result
print("The derivative of the function at x =", a + delta * (b - a) / (b - a), "is", derivative)
