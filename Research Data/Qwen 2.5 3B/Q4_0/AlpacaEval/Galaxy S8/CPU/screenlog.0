```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML tags
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<ul>", "<ul>"},
        {"<li>", "<li>"},
        {"<ol>", "<ol>"},
        {"<br>", "<br/>"},
        {"<a>", "<a href=\""},
        {"</a>", "\">"},
        {"<img>", "<img src=\""},
        {"</img>", "\" alt=\"\">"},
        // Add more mappings as needed
    };

    std::string htmlText = "";
    std::string temp = markdownText;
    std::string tempHtml = "";

    // Iterate through the markdown text and replace markdown tags with HTML tags
    for (const auto& [markdownTag, htmlTag] : markdownToHtmlMap) {
        while (temp.find(markdownTag) != std::string::npos) {
            size_t pos = temp.find(markdownTag);
            tempHtml += htmlTag;
            temp = temp.substr(pos + markdownTag.length());
        }
    }

    // Add any remaining text
    tempHtml += temp;

    return tempHtml;
}

