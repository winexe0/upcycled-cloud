```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML tags
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>\n"},
        {"<br>", "<br>\n"},
        {"<a href=", "<a href=\""},
        {"</a>", "\" />"},
        {"<img src=", "<img src=\""},
        {"</img>", "\" />"},
        // Add more mappings as needed
    };

    std::string htmlText;
    std::string temp;
    std::string line;

    // Split the markdown text into lines
    std::istringstream iss(markdownText);
    while (getline(iss, line)) {
        for (const auto& entry : markdownToHtmlMap) {
            temp = entry.first;
            line = line.replace(line.find(temp), temp.length(), entry.second);
        }
        htmlText += line + "\n";
    }

    return htmlText;
}

int main() {
    std::string markdownText = "# Hello, World!\n\n## This is a heading\n\n<p>This is a paragraph.</p>\n\n<a href=\"https://example.com\">Link to example</a>\n\n<img src=\"https://example.com/image.png\" alt=\"Example Image\">";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << "Markdown:\n" << markdownText << "\n\nHTML:\n" << htmlText << std::endl;

    return 0;
}
```

This function uses a simple mapping of markdown tags to HTML tags. It iterates over each line of the markdown text, replacing markdown tags with their corresponding HTML tags. Note that this is a very basic implementation and does not handle all possible markdown tags. For a more robust solution, you might want to use a library like `markdown` or `pandoc`.

