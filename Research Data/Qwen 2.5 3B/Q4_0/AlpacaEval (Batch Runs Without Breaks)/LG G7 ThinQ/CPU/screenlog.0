```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML tags
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<ul>", "<ul>"},
        {"<li>", "<li>"},
        {"<ol>", "<ol>"},
        {"<br>", "<br>"},
        {"<a>", "<a>"},
        {"<img>", "<img>"},
        // Add more mappings as needed
    };

    std::string htmlText;
    std::string::size_type pos = 0;
    std::string::size_type markdownLength = markdownText.length();

    while (pos < markdownLength) {
        std::string::size_type end = markdownText.find_first_of(" ", pos);
        if (end == std::string::npos) {
            end = markdownLength;
        }

        std::string markdownFragment = markdownText.substr(pos, end - pos);

        // Check if the fragment is a markdown tag
        for (const auto& [markdownTag, htmlTag] : markdownToHtmlMap) {
            if (markdownFragment.find(markdownTag) != std::string::npos) {
                htmlText += htmlTag;
                pos = end + markdownTag.length();
                break;
            }
        }

        // If no markdown tag found, append the fragment as is
        if (htmlText.empty()) {
            htmlText += markdownFragment;
        }

        pos = end;
    }

    return htmlText;
}

