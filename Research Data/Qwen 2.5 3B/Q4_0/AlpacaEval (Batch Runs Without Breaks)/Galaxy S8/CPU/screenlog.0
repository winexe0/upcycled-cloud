```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<ul>", "<ul>"},
        {"<li>", "<li>"},
        {"<ol>", "<ol>"},
        {"<br>", "<br/>"},
        {"<a href=", "<a href="},
        {"</a>", "</a>"},
        {"<img src=", "<img src="},
        {"</img>", "</img>"},
        {"<code>", "<code>"},
        {"</code>", "</code>"},
        // Add more mappings as needed
    };

    std::string htmlText;
    std::string temp;
    std::string currentTag;

    for (size_t i = 0; i < markdownText.length(); ++i) {
        char ch = markdownText[i];
        if (ch == '<') {
            // Check if the next character is a closing tag
            if (i + 1 < markdownText.length() && markdownText[i + 1] == '/') {
                // Find the corresponding opening tag
                for (const auto& [key, value] : markdownToHtmlMap) {
                    if (value.substr(1) == std::string(1, ch)) {
                        currentTag = key;
                        break;
                    }
                }
                // Append the closing tag to the HTML text
                htmlText += "</" + currentTag + ">";
                i += 2; // Skip the closing tag
            } else {
                // Append the opening tag to the HTML text
                htmlText += "<" + std::string(1, ch);
                i++; // Skip the opening tag
            }
        } else if (ch == '>') {
            // Append the closing tag to the HTML text
            htmlText += "</" + currentTag + ">";
            currentTag.clear();
        } else {
            // Append the character to the temporary string
            temp += ch;
            // Check if the temporary string matches any markdown to HTML mapping
            for (const auto& [key, value] : markdownToHtmlMap) {
                if (temp == key) {
                    htmlText += value;
                    temp.clear();
                    break;
                }
            }
        }
    }

    // Append any remaining characters in the temporary string
    if (!temp.empty()) {
        htmlText += temp;
    }

    return htmlText;
}

