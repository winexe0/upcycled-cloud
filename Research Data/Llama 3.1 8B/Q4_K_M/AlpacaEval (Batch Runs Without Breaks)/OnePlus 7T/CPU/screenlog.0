#include <string>
#include <regex>

std::string markdown_to_html(const std::string& markdown_text) {
    // Convert headers
    std::regex header_regex("^#{1,6} (.*)$");
    std::string html_text = std::regex_replace(markdown_text, header_regex, "<h%d>$1</h%d>", std::bind(&std::string::length, std::placeholders::_1));

    // Convert bold text
    std::regex bold_regex("\\*([^*]*)\\*");
    html_text = std::regex_replace(html_text, bold_regex, "<b>$1</b>");

    // Convert italic text
    std::regex italic_regex("\\*([^*]*)\\*");
    html_text = std::regex_replace(html_text, italic_regex, "<i>$1</i>");

    // Convert links
    std::regex link_regex("\\[([^\\[\\]]+)\\]\\(([^\\[\\]]+)\\)");
    html_text = std::regex_replace(html_text, link_regex, "<a href=\"$2\">$1</a>");

    // Convert images
    std::regex image_regex("\\!\\[([^\\[\\]]+)\\]\\(([^\\[\\]]+)\\)");
    html_text = std::regex_replace(html_text, image_regex, "<img src=\"$2\" alt=\"$1\">");

    // Convert unordered lists
    std::regex list_regex("^- (.*)$");
    html_text = std::regex_replace(html_text, list_regex, "<li>$1</li>", std::bind(&std::string::length, std::placeholders::_1));

    // Convert ordered lists
    std::regex ordered_list_regex("^\\d+\\. (.*)$");
    html_text = std::regex_replace(html_text, ordered_list_regex, "<li>$1</li>", std::bind(&std::string::length, std::placeholders::_1));

    // Convert code blocks
    std::regex code_block_regex("^```(.*)\n(.*?)\n```$");
    html_text = std::regex_replace(html_text, code_block_regex, "<pre><code>$2</code></pre>", std::bind(&std::string::length, std::placeholders::_1));

    return html_text;
}
```

This function uses regular expressions to convert markdown formatted text into html formatted text. It supports the following markdown features:

- Headers
- Bold text
- Italic text
- Links
- Images
- Unordered lists
- Ordered lists
- Code blocks

Note: This is a basic implementation and may not cover all edge cases. You may need to modify it to suit your specific requirements.

