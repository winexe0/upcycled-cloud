#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Process headings (e.g., # Heading -> <h1>Heading</h1>)
    size_t pos = 0;
    while ((pos = markdown.find("# ", pos)) != std::string::npos) {
        size_t headingLevel = 0;
        // Count the number of # symbols
        while (pos > 0 && markdown[pos - 1] == '#') {
            headingLevel++;
            pos--;
        }
        pos++; // Move past the '#'

        std::string headingText = markdown.substr(pos, markdown.find(' ', pos) - pos);
        html += "<h" + std::to_string(headingLevel) + ">" + headingText + "</h" + std::to_string(headingLevel) + ">";
        pos += headingText.length() + 1; // Skip the space after #
    }

    // Process bold (e.g., **bold** -> <strong>bold</strong>)
    pos = 0;
    while ((pos = markdown.find("**", pos)) != std::string::npos) {
        size_t start = pos + 2;
        size_t end = markdown.find("**", start);
        if (end == std::string::npos) break;

        std::string text = markdown.substr(start, end - start);
        html += "<strong>" + text + "</strong>";
        pos = end + 2;
    }

    // Process italic (e.g., *italic* -> <em>italic</em>)
    pos = 0;
    while ((pos = markdown.find("*", pos)) != std::string::npos) {
        size_t start = pos + 1;
        size_t end = markdown.find("*", start);
        if (end == std::string::npos) break;

        std::string text = markdown.substr(start, end - start);
        html += "<em>" + text + "</em>";
        pos = end + 1;
    }

    // Process links (e.g., [text](url) -> <a href="url">text</a>)
    pos = 0;
    while ((pos = markdown.find("[", pos)) != std::string::npos) {
        size_t startLink = pos + 1;
        size_t endLink = markdown.find("]", startLink);
        if (endLink == std::string::npos) break;

        size_t startUrl = markdown.find("(", endLink);
        if (startUrl == std::string::npos) break;
        startUrl++; // Skip '('
        size_t endUrl = markdown.find(")", startUrl);
        if (endUrl == std::string::npos) break;

        std::string linkText = markdown.substr(startLink, endLink - startLink);
        std::string url = markdown.substr(startUrl, endUrl - startUrl);
        html += "<a href=\"" + url + "\">" + linkText + "</a>";
        pos = endUrl + 1;
    }

    // Process images (e.g., ![alt](url) -> <img src="url" alt="alt">)
    pos = 0;
    while ((pos = markdown.find("!", pos)) != std::string::npos) {
        size_t startImg = pos + 1;
        size_t endImg = markdown.find("]", startImg);
        if (endImg == std::string::npos) break;

        size_t startUrl = markdown.find("(", endImg);
        if (startUrl == std::string::npos) break;
        startUrl++; // Skip '('
        size_t endUrl = markdown.find(")", startUrl);
        if (endUrl == std::string::npos) break;

        std::string alt = markdown.substr(startImg, endImg - startImg);
        std::string url = markdown.substr(startUrl, endUrl - startUrl);
        html += "<img src=\"" + url + "\" alt=\"" + alt + "\">";
        pos = endUrl + 1;
    }

