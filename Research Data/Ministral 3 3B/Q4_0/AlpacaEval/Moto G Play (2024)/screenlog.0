#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Helper function to escape HTML special characters
    auto escapeHtml = [](const std::string& str) {
        std::string result;
        for (char c : str) {
            switch (c) {
                case '&':  result += "&amp;"; break;
                case '"':  result += "&quot;"; break;
                case '\'': result += "&apos;"; break;
                case '<':  result += "&lt;"; break;
                case '>':  result += "&gt;"; break;
                default:   result += c; break;
            }
        }
        return result;
    };

    // Process the input string
    size_t pos = 0;
    while (pos < markdown.size()) {
        // Handle headings (e.g., # Heading)
        if (markdown[pos] == '#') {
            int level = 0;
            while (pos < markdown.size() && markdown[pos] == '#') {
                level++;
                pos++;
            }
            if (pos < markdown.size() && markdown[pos] == ' ') {
                pos++;
                std::string headingText = markdown.substr(pos);
                html += "<h" + std::to_string(level) + ">" + escapeHtml(headingText) + "</h" + std::to_string(level) + ">";
                pos += headingText.size();
            }
        }
        // Handle bold (e.g., **bold**)
        else if (markdown.substr(pos, 2) == "**") {
            pos += 2;
            std::string text = markdown.substr(pos);
            pos += text.size();
            html += "<b>" + escapeHtml(text) + "</b>";
        }
        // Handle italic (e.g., *italic*)
        else if (markdown.substr(pos, 2) == "*") {
            pos += 2;
            std::string text = markdown.substr(pos);
            pos += text.size();
            html += "<i>" + escapeHtml(text) + "</i>";
        }
        // Handle links (e.g., [text](url))
        else if (markdown.find("[", pos) != std::string::npos) {
            size_t start = markdown.find("[", pos);
            size_t end = markdown.find("]", start);
            if (end != std::string::npos) {
                std::string linkText = markdown.substr(start + 1, end - start - 1);
                pos = end + 1;
                size_t urlStart = markdown.find("(", pos);
                size_t urlEnd = markdown.find(")", urlStart);
                if (urlStart != std::string::npos && urlEnd != std::string::npos) {
                    std::string url = markdown.substr(urlStart + 1, urlEnd - urlStart - 1);
                    html += "<a href=\"" + escapeHtml(url) + "\">" + escapeHtml(linkText) + "</a>";
                    pos = urlEnd + 1;
                }
            }
        }
        // Handle blockquotes (e.g., > blockquote)
        else if (markdown.substr(pos, 1) == ">") {
            pos++;
            std::string blockquote = markdown.substr(pos);
            pos += blockquote.size();
            html += "<blockquote>" + escapeHtml(blockquote) + "</blockquote>";
        }
        // Handle lists (e.g., - item, * item, 1. item)
        else if (markdown.substr(pos, 1) == "-") {
            pos++;
            std::string listItem = markdown.substr(pos);
            pos += listItem.size();
            html += "<li>" + escapeHtml(listItem) + "</li>";
        }
        // Handle horizontal rule (e.g., *** or ****)
        else if (markdown.substr(pos, 3) == "***" || markdown.substr(pos, 4) == "*** ") {
            html += "<hr>";
            pos += 3;
        }
        // Handle unordered list (e.g., - item, * item)
        else if (markdown.substr(pos, 1) == "*" || markdown.substr(pos, 1) == "-") {
            pos++;
            std::string listItem = markdown.substr(pos);
            pos += listItem.size();
