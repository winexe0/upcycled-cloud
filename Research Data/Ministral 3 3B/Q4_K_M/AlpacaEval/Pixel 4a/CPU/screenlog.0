#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Process bold (**text**)
    size_t pos = 0;
    while ((pos = markdown.find("**", pos)) != std::string::npos) {
        size_t end = markdown.find("**", pos + 2);
        if (end == std::string::npos) break;

        html += markdown.substr(pos, end - pos);
        html += "<strong>";
        pos = end;
    }

    // Process bold again (after replacing **bold** with <strong>)
    pos = 0;
    while ((pos = html.find("**", pos)) != std::string::npos) {
        size_t end = html.find("**", pos + 2);
        if (end == std::string::npos) break;
        html.replace(pos, 2, "<strong>");
        pos = end;
    }

    // Process italic (*text*)
    pos = 0;
    while ((pos = markdown.find("*", pos)) != std::string::npos) {
        size_t end = markdown.find("*", pos + 1);
        if (end == std::string::npos) break;

        html += markdown.substr(pos, end - pos);
        html += "<em>";
        pos = end;
    }

    // Process italic again (after replacing *italic* with <em>)
    pos = 0;
    while ((pos = html.find("*", pos)) != std::string::npos) {
