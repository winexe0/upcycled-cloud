            std::string heading = markdown.substr(start, end - start);
            html += "<h" + std::to_string(level) + ">";
            html += heading;
            html += "</h" + std::to_string(level) + ">";
            pos = end;
        }
    }

    // Process lists (unordered)
    pos = 0;
