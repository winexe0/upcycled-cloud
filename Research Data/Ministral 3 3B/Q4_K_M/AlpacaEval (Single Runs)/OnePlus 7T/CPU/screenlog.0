```python
def average_rate_of_change(f, a, b):
    """
    Calculate the average rate of change of a function f between points a and b.
    This approximates the derivative at x = a.
    """
    return (f(b) - f(a)) / (b - a)

def evaluate_function(x, function_str):
    """
    Evaluate a function string at a given x.
    Example: For f(x) = x^2, input "x**2" and x=2 returns 4.
    """
    try:
        return eval(function_str, {'x': x})
    except Exception as e:
        return f"Error evaluating function: {e}"

def main():
    print("Average Rate of Change Calculator (Approximates Derivative)")
    print("--------------------------------------------------------")

    # Get user input for the function (e.g., "x**2 + 3*x - 1")
    function_str = input("Enter the function f(x) (e.g., 'x**2', 'sin(x)', '2*x + 1'): ").strip()
    print()

    # Get two points (a, b) where a < b
    try:
        a = float(input("Enter the value of x for point a: "))
        b = float(input("Enter the value of x for point b (must be > a): "))
        if b <= a:
            raise ValueError("b must be greater than a.")
    except ValueError as e:
        print(f"Invalid input: {e}. Please enter numerical values.")
        return

    # Evaluate f(a) and f(b)
    fa = evaluate_function(a, function_str)
    fb = evaluate_function(b, function_str)

    print(f"\nFunction evaluated at:")
    print(f"f({a}) = {fa}")
    print(f"f({b}) = {fb}")

    # Compute the average rate of change
    derivative_approx = average_rate_of_change(evaluate_function, a, b)
    print(f"\nAverage Rate of Change (≈ Derivative at x = {a}): {derivative_approx:.4f}")

if __name__ == "__main__":
    main()
```

