    """
    This function calculates the derivative of a function using the Average Rate of Change Formula.
    """
    # Define the function f(x)
    def f(x):
        return x**2
    
    # Calculate the derivative A(x)
    A = f(x) - f(0) / (x - 0)
    
    return A

# Get user input
