```cpp
#include <iostream>
#include <string>

// Function to convert markdown text to html
std::string markdownToHtml(const std::string& markdownText) {
    std::string htmlText = markdownText;

    // Replace markdown syntax with html tags
    size_t pos = 0;
    while ((pos = htmlText.find("[", pos)) != std::string::npos) {
        size_t endPos = htmlText.find("]", pos);
        if (endPos == std::string::npos) {
            endPos = htmlText.length();
        }
        std::string tag = htmlText.substr(pos, endPos - pos);
        size_t startPos = 0;
        while ((startPos = tag.find(">", startPos)) != std::string::npos) {
            std::string tagEnd = tag.substr(startPos, 2);
            if (tagEnd == "</" + tag.substr(0, startPos) + ">") {
                break;
            }
            htmlText.replace(startPos, 2, "</" + tag.substr(0, startPos) + ">");
            startPos += 2;
        }
    }

    // Replace markdown syntax with html tags
    pos = 0;
    while ((pos = htmlText.find("[", pos)) != std::string::npos) {
        size_t endPos = htmlText.find("]", pos);
        if (endPos == std::string::npos) {
            endPos = htmlText.length();
        }
        std::string tag = htmlText.substr(pos, endPos - pos);
        size_t startPos = 0;
        while ((startPos = tag.find(">", startPos)) != std::string::npos) {
            std::string tagEnd = tag.substr(startPos, 2);
            if (tagEnd == "</" + tag.substr(0, startPos) + ">") {
                break;
            }
            htmlText.replace(startPos, 2, "</" + tag.substr(0, startPos) + ">");
            startPos += 2;
        }
    }

    return htmlText;
}

int main() {
    std::string markdownText = "This is a [markdown](http://example.com) text.";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << "Markdown Text: " << markdownText << std::endl;
    std::cout << "HTML Text: " << htmlText << std::endl;
    return 0;
}
```

This function works by first replacing the markdown syntax with html tags. It then replaces the remaining markdown syntax with html tags. The function returns the resulting html text. The example usage in the `main` function demonstrates how to use the function to convert markdown text to html text.

