Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/-\|/ Here's a C++ function that takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text:

```cpp
#include <iostream>
#include <string>

std::string markdownToHtml(const std::string& markdownText) {
    // Define a simple markdown to html converter
    std::string htmlText = "<html><body>";
    size_t pos = 0;
    while (pos < markdownText.size()) {
        if (markdownText[pos] == '#') {
            // HTML header
            htmlText += "<h1>" + markdownText.substr(pos + 1, 2) + "</h1>";
            pos += 2;
        } else if (markdownText[pos] == '*') {
            // HTML bold
            htmlText += "<b>" + markdownText.substr(pos + 1, 2) + "</b>";
            pos += 2;
        } else if (markdownText[pos] == '[') {
            // HTML link
            htmlText += "<a href=\"" + markdownText.substr(pos + 1, 2) + "\">" + markdownText.substr(pos + 2, 2) + "</a>";
            pos += 2;
        } else if (markdownText[pos] == ']') {
            // HTML closing bracket
            htmlText += "</a>";
            pos++;
        } else {
            // Append the markdown text to the html text
            htmlText += markdownText.substr(pos, 2);
            pos++;
        }
    }
    htmlText += "</body></html>";

    return htmlText;
}

int main() {
    std::string markdownText = "# Hello World!\n* This is a bold text*\n[ Click here](https://www.example.com)";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;

    return 0;
}
```

This function works by iterating over the markdown text and appending the corresponding HTML tags to the `htmlText` string. The HTML tags are defined as follows:

- `#` is an HTML header tag
- `*` is an HTML bold tag
- `[ ]` is an HTML link tag
- `</a>` is an HTML closing bracket tag

The function also handles the case where the markdown text does not match any of the above tags, in which case it simply appends the markdown text to the `htmlText` string.

