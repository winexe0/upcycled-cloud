#include <iostream>
#include <string>

std::string markdown_to_html(const std::string& markdown_text) {
    // Convert markdown text to html
    std::string html_text = "<html><head><style>body { font-family: Arial, sans-serif; }</style></head><body>" + markdown_text + "</body></html>";

    return html_text;
}

int main() {
    std::string markdown_text = "# Heading\n## Subheading\nThis is a paragraph of text.";
    std::cout << markdown_to_html(markdown_text) << std::endl;

    return 0;
}
```

This C++ function `markdown_to_html` takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text. The function uses the `std::string` constructor to create a new string that is a copy of the input markdown text. It then uses an HTML template to convert the markdown text to html. The `main` function demonstrates how to use this function with a sample markdown text.

