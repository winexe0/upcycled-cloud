import numpy as np

def calculate_derivative():
    # Get user input for the function and its derivative
    func_name = input("Enter the name of the function: ")
    f_prime_name = input("Enter the name of the derivative function: ")

    # Get the function and its derivative from the user
    try:
        f = np.poly1d(np.polyval(np.polyroots([1, 0, 0]), np.poly1d([1, 0, 0]).coeffs()[0]))
        f_prime = np.poly1d(np.polyval(np.polyroots([1, 0, 0]), np.poly1d([1, 0, 0]).coeffs()[1]))
    except Exception as e:
        print("Error:", e)

    # Calculate the derivative
    try:
        derivative = f_prime - f
    except Exception as e:
        print("Error:", e)

    # Print the result
    print(f"The derivative of {func_name} is {derivative}")

# Run the script
calculate_derivative()
