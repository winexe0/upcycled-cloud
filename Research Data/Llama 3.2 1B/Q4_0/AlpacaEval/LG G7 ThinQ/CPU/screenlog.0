#include <iostream>
#include <string>

std::string markdown_to_html(const std::string& markdown_text) {
    // Convert markdown text to html
    std::string html_text = "<html><head><style>body { font-family: Arial, sans-serif; }</style></head><body>" + markdown_text + "</body></html>";

    return html_text;
}

int main() {
    std::string markdown_text = "# Heading\n## Subheading\nThis is a paragraph of text.";
    std::cout << markdown_to_html(markdown_text) << std::endl;

    return 0;
}
```

In this code:

- We define a function `markdown_to_html` that takes a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text.
- We use the `std::string` class to create a new string that contains the html formatted text.
- We use an `std::string` literal to create a new string that contains the markdown text.
- In the `main` function, we create a `std::string` containing markdown formatted text and pass it to the `markdown_to_html` function to get the html formatted text.
- We print the html formatted text to the console.

