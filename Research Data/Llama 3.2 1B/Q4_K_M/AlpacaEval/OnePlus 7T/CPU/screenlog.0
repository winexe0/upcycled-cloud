Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/- Here's a C++ function that takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text.

```cpp
#include <iostream>
#include <string>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Replace markdown syntax with html syntax
    std::string htmlText = markdownText;
    size_t pos = 0;
    while ((pos = htmlText.find("[", pos)) != std::string::npos) {
        size_t endPos = htmlText.find("]", pos);
        if (endPos == std::string::npos) break;
        htmlText.replace(pos, 1, "<");
        pos += 1;
        endPos += 1;
        while (endPos < htmlText.size() && htmlText[endPos] != '>') endPos++;
        htmlText.replace(pos, endPos - pos + 1, ">");
        pos += 1;
    }
    while (pos < htmlText.size() && htmlText[pos] == '>') pos++;

    // Replace markdown syntax with html syntax
    pos = 0;
    while ((pos = htmlText.find("[", pos)) != std::string::npos) {
        size_t endPos = htmlText.find("]", pos);
        if (endPos == std::string::npos) break;
        htmlText.replace(pos, 1, "<");
        pos += 1;
        endPos += 1;
        while (endPos < htmlText.size() && htmlText[endPos] != '>') endPos++;
        htmlText.replace(pos, endPos - pos + 1, ">");
        pos += 1;
    }
    while (pos < htmlText.size() && htmlText[pos] == '>') pos++;

    // Replace markdown syntax with html syntax
    pos = 0;
    while ((pos = htmlText.find("[", pos)) != std::string::npos) {
        size_t endPos = htmlText.find("]", pos);
        if (endPos == std::string::npos) break;
        htmlText.replace(pos, 1, "<");
        pos += 1;
        endPos += 1;
        while (endPos < htmlText.size() && htmlText[endPos] != '>') endPos++;
        htmlText.replace(pos, endPos - pos + 1, ">");
        pos += 1;
    }
    while (pos < htmlText.size() && htmlText[pos] == '>') pos++;

    return htmlText;
}

int main() {
    std::string markdownText = "This is a [test](http://example.com) with [multiple](http://example2.com) [links].";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << "Markdown text: " << markdownText << std::endl;
    std::cout << "HTML text: " << htmlText << std::endl;
    return 0;
}
```

This function works by replacing the markdown syntax with the corresponding html syntax. The markdown syntax is defined as `[text](url)`, where `text` is the text and `url` is the URL. The function replaces each occurrence of this syntax with the corresponding html syntax, which is `<text>`.

The function also replaces the `>` character with `<` to ensure that the html syntax is correctly formatted.

The example in the `main` function demonstrates how to use the `markdownToHtml` function to convert markdown formatted text to html formatted text.

