Instruction:
Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/-\|/-\|/-\| Here's a C++ function that takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text:

```cpp
#include <iostream>
#include <string>

/**
 * Converts markdown formatted text to html formatted text.
 *
 * @param markdownText A reference to a std::string containing markdown formatted text.
 * @return A std::string containing html formatted text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    std::string htmlText = markdownText;
    size_t pos = 0;
    while (pos < htmlText.size()) {
        // Find the first occurrence of a markdown link
        size_t linkPos = htmlText.find("[", pos);
        if (linkPos == std::string::npos) {
            // If no link is found, append the text as is
            break;
        }

        // Find the corresponding closing bracket
        size_t closePos = htmlText.find("]", linkPos);
        if (closePos == std::string::npos) {
            // If no closing bracket is found, append the text as is
            break;
        }

        // Extract the link text and URL
        std::string linkText = htmlText.substr(linkPos + 1, closePos - linkPos - 1);
        std::string linkUrl = htmlText.substr(closePos + 1);

        // Replace the markdown link with its corresponding html link
        htmlText.replace(linkPos + 1, closePos - linkPos - 1, "<a href=\"" + linkUrl + "\">" + linkText + "</a>");

        // Move to the next occurrence of the markdown link
        pos = linkPos + 1;
    }

    return htmlText;
}

int main() {
    std::string markdownText = "This is a [test](http://example.com) string with [multiple](http://example2.com) links.";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << "Markdown text: " << markdownText << std::endl;
    std::cout << "Html text: " << htmlText << std::endl;
    return 0;
}
```

This function works by iterating over the markdown text and finding the first occurrence of a markdown link. It then finds the corresponding closing bracket and extracts the link text and URL. It replaces the markdown link with its corresponding html link and moves to the next occurrence of the markdown link. The function returns the html text after all markdown links have been replaced.

