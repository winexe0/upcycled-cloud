Instruction:
Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/- Here's a C++ function that takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing html formatted text.

```cpp
#include <iostream>
#include <string>
#include <stdexcept>

std::string markdownToHtml(const std::string& markdownText) {
    if (markdownText.empty()) {
        throw std::invalid_argument("Input string cannot be empty");
    }

    std::string htmlText = markdownText;
    size_t pos = 0;
    while ((pos = htmlText.find("<", pos)) != std::string::npos) {
        size_t endPos = htmlText.find(">", pos);
        if (endPos == std::string::npos) {
            throw std::invalid_argument("Invalid markdown syntax");
        }
        std::string tag = htmlText.substr(pos, endPos - pos + 1);
        size_t spacePos = tag.find(" ");
        if (spacePos == std::string::npos) {
            throw std::invalid_argument("Invalid markdown syntax");
        }
        std::string tagName = tag.substr(0, spacePos);
        std::string attributes = tag.substr(spacePos + 1);
        size_t closingPos = htmlText.find(">", endPos);
        if (closingPos == std::string::npos) {
            throw std::invalid_argument("Invalid markdown syntax");
        }
        std::string closingTag = htmlText.substr(closingPos + 1, closingPos - closingPos + 1);
        htmlText.replace(pos, endPos - pos + 1, "<" + tagName + " " + attributes + ">");
        pos = closingPos + 1;
    }

    return htmlText;
}
```

This function works by iterating over the markdown text and replacing each opening tag with its corresponding closing tag, along with any attributes. It also handles cases where the markdown text contains invalid syntax.

Example usage:

```cpp
int main() {
    try {
        std::string markdownText = R"(
# Heading
## Subheading
This is a [link](http://example.com).
This is another [link](http://example2.com).
);
        std::string htmlText = markdownToHtml(markdownText);
        std::cout << "Markdown text: " << markdownText << std::endl;
        std::cout << "HTML text: " << htmlText << std::endl;
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }

    return 0;
}
```

This example creates a `std::string` containing markdown formatted text, calls the `markdownToHtml` function to convert it to html formatted text, and prints both the original markdown text and the resulting html text.

