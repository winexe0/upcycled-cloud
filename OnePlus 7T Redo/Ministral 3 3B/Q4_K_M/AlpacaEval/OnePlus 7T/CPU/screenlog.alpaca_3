#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;
    size_t pos = 0;

    while (pos < markdown.size()) {
        // Handle bold (**text**)
        if (markdown.find("**", pos) != std::string::npos) {
            size_t bold_start = markdown.find("**", pos);
            size_t bold_end = markdown.find("**", bold_start + 2);
            if (bold_end != std::string::npos) {
                html += "<strong>";
                html += markdown.substr(bold_start + 2, bold_end - bold_start - 2);
                html += "</strong>";
                pos = bold_end + 2;
                continue;
            }
        }

        // Handle italic (*text*)
        if (markdown.find("*", pos) != std::string::npos) {
            size_t italic_start = markdown.find("*", pos);
            size_t italic_end = markdown.find("*", italic_start + 1);
            if (italic_end != std::string::npos) {
                html += "<em>";
                html += markdown.substr(italic_start + 1, italic_end - italic_start - 1);
                html += "</em>";
                pos = italic_end + 1;
                continue;
            }
        }

        // Handle links [text](url)
        if (markdown.find("[", pos) != std::string::npos) {
            size_t link_start = markdown.find("[", pos);
            size_t link_end = markdown.find("]", link_start);
            if (link_end != std::string::npos) {
                size_t url_start = markdown.find("(", link_end);
                size_t url_end = markdown.find(")", url_start);
                if (url_start != std::string::npos && url_end != std::string::npos) {
                    html += "<a href=\"" + markdown.substr(url_start + 1, url_end - url_start - 1) + "\">";
                    html += markdown.substr(link_start + 1, link_end - link_start - 1);
                    html += "</a>";
                    pos = url_end + 1;
                    continue;
                }
            }
        }

        // Handle headings (### Heading)
        if (markdown.find("#", pos) != std::string::npos) {
            size_t level = 0;
            size_t heading_start = pos;
            while (pos < markdown.size() && markdown[pos] == '#') {
                level++;
                pos++;
            }
            if (pos < markdown.size() && markdown[pos] == ' ') {
                pos++; // Skip space after #
                size_t heading_end = pos;
                while (heading_end < markdown.size() && markdown[heading_end] != '\n') {
                    heading_end++;
                }
                html += "<h" + std::to_string(level) + ">";
                html += markdown.substr(heading_start, heading_end - heading_start);
                html += "</h" + std::to_string(level) + ">";
                pos = heading_end;
                continue;
            }
        }

        // Handle blockquotes (>)
        if (markdown.find(">", pos) != std::string::npos) {
            size_t blockquote_start = pos;
            while (pos < markdown.size() && markdown[pos] != '\n') {
                pos++;
            }
            html += "<blockquote>";
            html += markdown.substr(blockquote_start, pos - blockquote_start);
            html += "</blockquote>";
            continue;
        }

        // Handle lists (bullet points and ordered lists)
        if (markdown.find("-", pos) != std::string::npos) {
            size_t list_start = pos;
            while (pos < markdown.size() && markdown[pos] != '\n') {
                pos++;
            }
            html += "<ul>";
            html += "<li>" + markdown.substr(list_start, pos - list_start) + "</li>";
            html += "</ul>";
            continue;
