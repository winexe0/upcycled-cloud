Instruction:
Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/-\|/-\|/-\|/-\|/- Here's a C++ function that uses the markdown library to convert markdown formatted text to HTML formatted text:

```cpp
#include <iostream>
#include <string>
#include <markdown.h>

std::string markdownToHtml(const std::string& markdownText) {
    // Initialize the markdown parser
    markdown_parser_t* parser = markdown_parser_new();
    markdown_parser_set_options(parser, MARKDOWN_PARSE HTML);

    // Parse the markdown text
    markdown_text_t* text = markdown_text_new_from_string(markdownText.c_str());
    markdown_node_t* root = markdown_parse(text, parser);

    // Convert the markdown nodes to HTML
    std::string htmlText;
    markdown_node_t* node = root;
    while (node != NULL) {
        if (markdown_node_is_text(node)) {
            htmlText += markdown_node_text(node);
        } else if (markdown_node_is_list(node)) {
            htmlText += "<ul>";
            for (int i = 0; i < markdown_node_list_length(node); i++) {
                htmlText += "<li>" + markdown_node_text(markdown_node_list_item(node, i)) + "</li>";
            }
            htmlText += "</ul>";
        } else if (markdown_node_is_header(node)) {
            htmlText += "<h" + std::to_string(markdown_node_header_level(node)) + ">" + markdown_node_text(node) + "</h" + std::to_string(markdown_node_header_level(node)) + ">";
        } else if (markdown_node_is_link(node)) {
            htmlText += markdown_node_link(node);
        } else if (markdown_node_is_image(node)) {
            htmlText += markdown_node_image(node);
        }
        node = markdown_node_next(node);
    }

    // Clean up
    markdown_text_free(text);
    markdown_node_free(root);
    markdown_parser_free(parser);

    return htmlText;
}

int main() {
    std::string markdownText = "# Heading\n## Subheading\nThis is a [link](http://example.com) and an image ![image](http://example.com/image.jpg)";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;
    return 0;
}
```

This code uses the markdown library to parse the markdown text and convert it to HTML. It supports basic markdown formatting, including headers, links, and images. The `markdownToHtml` function takes a reference to a `std::string` containing markdown formatted text and returns a `std::string` containing HTML formatted text.

Please note that you need to install the markdown library to use this code. You can install it using your package manager or by downloading the library from the official website.

