```cpp
#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Process bold (**text**)
    size_t pos = 0;
    while ((pos = markdown.find("**", pos)) != std::string::npos) {
        size_t end = markdown.find("**", pos + 2);
        if (end == std::string::npos) break;

        html += markdown.substr(pos, end - pos);
        html += "<strong>";
        pos = end;
    }

    // Process bold (**text**) again (handles nested cases)
    pos = 0;
    while ((pos = markdown.find("**", pos)) != std::string::npos) {
        size_t end = markdown.find("**", pos + 2);
        if (end == std::string::npos) break;

        html += "<strong>";
        pos = end;
    }

    // Process italic (*text*)
    pos = 0;
    while ((pos = markdown.find("*", pos)) != std::string::npos) {
        size_t end = markdown.find("*", pos + 1);
        if (end == std::string::npos) break;

        html += markdown.substr(pos, end - pos);
        html += "<em>";
        pos = end;
    }

    // Process italic (*text*) again
    pos = 0;
    while ((pos = markdown.find("*", pos)) != std::string::npos) {
        size_t end = markdown.find("*", pos + 1);
        if (end == std::string::npos) break;

        html += "<em>";
        pos = end;
    }

    // Process links [text](url)
    pos = 0;
    while ((pos = markdown.find("[", pos)) != std::string::npos) {
        size_t link_start = pos;
        size_t link_end = markdown.find("]", link_start);
        if (link_end == std::string::npos) break;

        size_t url_start = markdown.find("(", link_end);
        if (url_start == std::string::npos) break;
        size_t url_end = markdown.find(")", url_start);
        if (url_end == std::string::npos) break;

        html += markdown.substr(link_start, url_start - link_start);
        html += "<a href=\"" + markdown.substr(url_start + 1, url_end - url_start - 1) + "\">";
        html += markdown.substr(link_end + 1, url_start - link_end - 1);
        pos = url_end;
    }

    // Process headings (# heading)
    pos = 0;
    while ((pos = markdown.find("#", pos)) != std::string::npos) {
        size_t heading_start = pos;
        size_t heading_end = markdown.find("\n", heading_start);
        if (heading_end == std::string::npos) break;

        int level = 0;
        for (size_t i = heading_start; i < heading_end; ++i) {
            if (markdown[i] == '#') level++;
            else break;
        }

        html += "<h" + std::to_string(level) + ">";
        html += markdown.substr(heading_start + level, heading_end - heading_start - level);
        html += "</h" + std::to_string(level) + ">";
        pos = heading_end;
    }

    // Process lists (bullet points)
    pos = 0;
    while ((pos = markdown.find("- ", pos)) != std::string::npos) {
        size_t list_start = pos;
        size_t list_end = markdown.find("\n", list_start);
        if (list_end == std::string::npos) break;

        html += "<li>";
        html += markdown.substr(list_start + 2, list_end - list_start - 2);
        html += "</li>";
        pos = list_end;
    }

    // Replace newlines with <br> (simplified)
    std::replace(html.begin(), html.end(), '\n', '<br>');

    return html;
}
```

### Notes:
1. **Limitations**: This is a basic implementation and does not handle:
   - Nested lists or ordered lists.
   - Code blocks, tables, or other advanced Markdown features.
   - Escaping special characters (e.g., `&` → `&amp;`).

2. **Improvements**: For production use, consider:
   - Using a library like [Markdown-CPP

