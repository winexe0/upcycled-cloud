Instruction:
Write a C++ function that takes a reference to a std::string containing markdown formatted text and returns a std::string containing html formatted text.

Response:

|-\|/-\|/-\|/-\|/-\|/-\|/ Here's a C++ function that uses the markdown library to convert markdown text to HTML:

```cpp
#include <iostream>
#include <string>
#include <markdown.h>

std::string markdownToHtml(const std::string& markdownText) {
    markdown::MarkdownInp markdownInput(markdownText);
    markdown::MarkdownOut markdownOutput;
    markdown::Convert(&markdownInput, &markdownOutput);
    return markdownOutput.c_str();
}

int main() {
    std::string markdownText = "# Hello, World!";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;
    return 0;
}
```

This function uses the markdown library to convert markdown text to HTML. The `markdown::Convert` function takes a markdown input and output, and converts the markdown text to HTML.

Please note that you need to install the markdown library to use this function. You can install it using your package manager or by downloading it from the official website.

Alternatively, you can use a simpler approach without using a library, by manually parsing the markdown text and converting it to HTML. Here's an example of how you can do it:

```cpp
#include <iostream>
#include <string>

std::string markdownToHtml(const std::string& markdownText) {
    std::string htmlText;
    size_t pos = 0;
    while (pos < markdownText.size()) {
        if (markdownText[pos] == '#') {
            size_t level = 1;
            while (pos < markdownText.size() && markdownText[pos] == '#') {
                level++;
                pos++;
            }
            htmlText += "<h" + std::to_string(level) + ">";
        } else if (markdownText[pos] == '*') {
            htmlText += "<em>";
        } else if (markdownText[pos] == '_') {
            htmlText += "<i>";
        } else if (markdownText[pos] == '[') {
            size_t endPos = markdownText.find(']');
            if (endPos != std::string::npos) {
                htmlText += "<a href=\"" + markdownText.substr(pos + 1, endPos - pos - 1) + "\">";
                pos = endPos + 1;
            }
        } else if (markdownText[pos] == ']') {
            htmlText += "</a>";
        } else if (markdownText[pos] == '(') {
            size_t endPos = markdownText.find(')');
            if (endPos != std::string::npos) {
                htmlText += "<code>" + markdownText.substr(pos + 1, endPos - pos - 1) + "</code>";
                pos = endPos + 1;
            }
        } else if (markdownText[pos] == ')') {
            htmlText += "</code>";
        } else {
            htmlText += markdownText[pos];
        }
        pos++;
    }
    return htmlText;
}

int main() {
    std::string markdownText = "# Hello, World!";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << htmlText << std::endl;
    return 0;
}
```

This function manually parses the markdown text and converts it to HTML. It supports basic markdown syntax, including headers, bold text, italic text, links, and code blocks.

