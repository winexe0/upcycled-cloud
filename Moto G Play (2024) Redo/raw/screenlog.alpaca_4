#include <string>
#include <algorithm>

std::string markdownToHtml(const std::string& markdown) {
    std::string html;

    // Process headings (e.g., # Heading -> <h1>Heading</h1>)
    size_t pos = 0;
    while ((pos = markdown.find("# ", pos)) != std::string::npos) {
        size_t headingLevel = 0;
        // Count the number of # signs
        while (pos > 0 && markdown[pos - 1] == '#') {
            headingLevel++;
            pos--;
        }
        pos++; // Move past the '#'

        std::string headingText = markdown.substr(pos, markdown.find(" ", pos) - pos);
        html += "<h" + std::to_string(headingLevel) + ">" + headingText + "</h" + std::to_string(headingLevel) + ">";
        pos += headingText.length() + 1; // Skip the space after heading
    }

    // Process bold (e.g., **bold** -> <strong>bold</strong>)
    pos = 0;
    while ((pos = markdown.find("**", pos)) != std::string::npos) {
        size_t start = pos + 2;
        size_t end = markdown.find("**", start);
        if (end == std::string::npos) end = markdown.length();
        std::string boldText = markdown.substr(start, end - start);
        html += "<strong>" + boldText + "</strong>";
        pos = end;
    }

    // Process italic (e.g., *italic* -> <em>italic</em>)
    pos = 0;
    while ((pos = markdown.find("*", pos)) != std::string::npos) {
        size_t start = pos + 1;
        size_t end = markdown.find("*", start);
        if (end == std::string::npos) end = markdown.length();
        std::string italicText = markdown.substr(start, end - start);
        html += "<em>" + italicText + "</em>";
        pos = end;
    }

    // Process links (e.g., [text](url) -> <a href="url">text</a>)
    pos = 0;
    while ((pos = markdown.find("[", pos)) != std::string::npos) {
        size_t start = pos + 1;
        size_t end = markdown.find("]", start);
        if (end == std::string::npos) end = markdown.length();
        std::string linkText = markdown.substr(start, end - start);
        pos = end + 1; // Skip the ']'

        size_t urlStart = markdown.find("(", pos);
        if (urlStart == std::string::npos) {
            pos = end + 1;
            continue;
        }
        size_t urlEnd = markdown.find(")", urlStart);
        if (urlEnd == std::string::npos) urlEnd = markdown.length();
        std::string url = markdown.substr(urlStart + 1, urlEnd - urlStart - 1);
        html += "<a href=\"" + url + "\">" + linkText + "</a>";
        pos = urlEnd + 1;
    }

    // Process images (e.g., ![alt](url) -> <img src="url" alt="alt">)
