```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML tags
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<br>", "<br>"},
        {"<a href=", "<a href="},
        {"</a>", "</a>"},
        {"<img src=", "<img src="},
        {"</img>", "</img>"},
        {"<ul>", "<ul>"},
        {"</ul>", "</ul>"},
        {"<li>", "<li>"},
        {"</li>", "</li>"},
        {"<ol>", "<ol>"},
        {"</ol>", "</ol>"},
        {"<div>", "<div>"},
        {"</div>", "</div>"},
        {"<table>", "<table>"},
        {"</table>", "</table>"},
        {"<tr>", "<tr>"},
        {"</tr>", "</tr>"},
        {"<td>", "<td>"},
        {"</td>", "</td>"},
        {"<p>", "<p>"},
        {"</p>", "</p>"},
        {"<span>", "<span>"},
        {"</span>", "</span>"},
        {"<strong>", "<strong>"},
        {"</strong>", "</strong>"},
        {"<em>", "<em>"},
        {"</em>", "</em>"},
        {"<code>", "<code>"},
        {"</code>", "</code>"},
        {"<pre>", "<pre>"},
        {"</pre>", "</pre>"},
        // Add more mappings as needed
    };

    std::string htmlText = markdownText;
    for (const auto& [markdownTag, htmlTag] : markdownToHtmlMap) {
        htmlText = htmlText.replace(htmlText.find(markdownTag), markdownTag.length(), htmlTag);
    }

    return htmlText;
}

int main() {
    std::string markdownText = "# Hello, World!\n\n## This is a heading.\n\n<code>console.log('Hello, World!');</code>\n\n<ol>\n<li>Item 1</li>\n<li>Item 2</li>\n</ol>";
    std::string htmlText = markdownToHtml(markdownText);
    std::cout << "Markdown:\n" << markdownText << "\n\nHTML:\n" << htmlText << std::endl;
    return 0;
}
```

This function uses a simple map to replace markdown tags with their corresponding HTML tags. You can expand this map to include more markdown-to-HTML mappings as needed. For a more robust solution, consider using a library like `markdown` or `pandoc`.

