```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML
    std::map<std::string, std::string> markdownToHtmlMap = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<ul>", "<ul>"},
        {"<li>", "<li>"},
        {"<ol>", "<ol>"},
        {"<br>", "<br/>"},
        {"<a ", "<a href=\""},
        {"</a>", "\">"},
        {"<img ", "<img src=\""},
        {"</img>", "\" />"},
        // Add more mappings as needed
    };

    std::string htmlText = markdownText;
    for (const auto& [markdown, html] : markdownToHtmlMap) {
        htmlText = htmlText.replace(htmlText.find(markdown), markdown.length(), html);
    }

    return htmlText;
}

int main() {
