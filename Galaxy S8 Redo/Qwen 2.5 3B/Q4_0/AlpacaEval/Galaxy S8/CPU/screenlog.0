```cpp
#include <string>
#include <iostream>

// Function to convert markdown to HTML
std::string markdownToHtml(const std::string& markdownText) {
    // Simple mapping of markdown to HTML tags
    std::map<std::string, std::string> markdownToHtmlMapping = {
        {"# ", "<h1>"},
        {"## ", "<h2>"},
        {"### ", "<h3>"},
        {"#### ", "<h4>"},
        {"##### ", "<h5>"},
        {"###### ", "<h6>"},
        {"<p>", "<p>"},
        {"<ul>", "<ul>"},
        {"<li>", "<li>"},
        {"<ol>", "<ol>"},
        {"<br>", "<br/>"},
        {"<a ", "<a href=\""},
        {"</a>", "\">"},
        {"<img ", "<img src=\""},
        {"</img>", "\" alt=\"\">"},
        // Add more mappings as needed
    };

    std::string htmlText;
    std::string temp;
    std::string currentTag;

    for (size_t i = 0; i < markdownText.length(); ++i) {
        char ch = markdownText[i];
        if (ch == ' ') {
            if (!temp.empty()) {
                for (auto& [key, value] : markdownToHtmlMapping) {
                    if (temp == key) {
                        htmlText += value;
                        temp.clear();
                        break;
                    }
                }
                if (temp != "") {
                    htmlText += temp;
                    temp.clear();
                }
            }
        } else {
            temp += ch;
        }
    }

    // Handle any remaining text in temp
    if (!temp.empty()) {
        for (auto& [key, value] : markdownToHtmlMapping) {
            if (temp == key) {
                htmlText += value;
                temp.clear();
                break;
            }
        }
        if (temp != "") {
            htmlText += temp;
        }
    }

    return htmlText;
}

