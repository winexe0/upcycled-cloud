```cpp
#include <iostream>
#include <string>
#include <markdown.h>

/**
 * Converts markdown text to HTML.
 *
 * @param markdownText The markdown text to convert.
 * @return The HTML text.
 */
std::string markdownToHtml(const std::string& markdownText) {
    // Initialize the markdown parser
    markdown_parser_t *parser = markdown_parser_new();
    if (!parser) {
        throw std::runtime_error("Failed to initialize markdown parser");
    }

    // Parse the markdown text
    markdown_text_t *text = markdown_parse(markdownText.c_str());
    if (!text) {
        markdown_parser_free(parser);
        throw std::runtime_error("Failed to parse markdown text");
    }

    // Convert the markdown text to HTML
    std::string htmlText = markdown_render_html(text);

    // Clean up
    markdown_text_free(text);
    markdown_parser_free(parser);

    return htmlText;
}

int main() {
    try {
        std::string markdownText = "# This is a heading\n\nThis is a paragraph with **bold** text.";
        std::string htmlText = markdownToHtml(markdownText);
        std::cout << htmlText << std::endl;
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }

    return 0;
}
```

This code uses the markdown library to convert markdown text to HTML. The `markdownToHtml` function takes a reference to a `std::string` containing markdown text, parses it, and then converts it to HTML using the `markdown_render_html` function. The resulting HTML text is then returned.

Please note that you need to install the markdown library and link it to your project in order to use this code.

